rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque joueur ne peut lire et écrire que sa propre progression
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // LoL Master : profil public (collection et équipe), lisible par tous les joueurs connectés
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // LoL Master : marché
    match /market/{id} {
      allow read: if request.auth != null;
      // mettre une carte en vente
      allow create: if request.auth != null
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.claimed == false
        && request.resource.data.card is string
        && request.resource.data.price is int
        && request.resource.data.price >= 1 && request.resource.data.price <= 1000000;
      allow update: if request.auth != null && (
        // le vendeur retire sa carte
        (resource.data.seller == request.auth.uid && resource.data.status == "open"
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
        // le vendeur récupère l'or d'une vente
        || (resource.data.seller == request.auth.uid && resource.data.status == "sold" && resource.data.claimed == false
          && request.resource.data.claimed == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["claimed"]))
        // un autre joueur achète
        || (resource.data.seller != request.auth.uid && resource.data.status == "open"
          && request.resource.data.status == "sold" && request.resource.data.buyer == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "buyer", "buyerName", "soldAt"]))
      );
    }
  }
}
